<Window x:Class="DashboardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DashboardApp.ViewModels"
        Title="Dashboard Penjualan" Height="720" Width="1180" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Sidebar}">
            <StackPanel>
                <TextBlock Text="📊 Dashboard" Foreground="White" FontSize="20" FontWeight="Bold" Margin="20,26,20,26"/>
                <Button Style="{StaticResource NavButton}" Content="Ringkasan"/>
                <Button Style="{StaticResource NavButton}" Content="Pesanan"/>
                <Button Style="{StaticResource NavButton}" Content="Pelanggan"/>
                <Button Style="{StaticResource NavButton}" Content="Laporan"/>
                <Button Style="{StaticResource NavButton}" Content="Pengaturan"/>
            </StackPanel>
        </Border>

        <!-- Konten -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Margin="8,4,8,8">
                <Button DockPanel.Dock="Right" Content="⟳ Refresh" Command="{Binding RefreshCommand}"
                        Padding="16,8" Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <StackPanel>
                    <TextBlock Text="Ringkasan Penjualan" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LastUpdate}" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>

            <!-- KPI Cards -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" BorderThickness="0,4,0,0"
                                BorderBrush="{Binding Accent}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
                                <TextBlock Text="{Binding Delta}" FontSize="12" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Grafik + Tabel -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Penjualan Bulanan (juta Rp)" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Sales}" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" Margin="4,0">
                                        <TextBlock Text="{Binding Value, StringFormat=N0}" FontSize="10"
                                                   HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                        <Rectangle Height="{Binding BarHeight}" Fill="#4F46E5" RadiusX="4" RadiusY="4" Margin="0,2"/>
                                        <TextBlock Text="{Binding Month}" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Pesanan Terbaru" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEE" BorderThickness="0" Background="White"
                                  RowHeaderWidth="0" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                                <DataGridTextColumn Header="Pelanggan" Binding="{Binding Customer}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='Rp {0:N0}'}" Width="Auto"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
